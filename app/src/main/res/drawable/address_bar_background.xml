<?xml version="1.0" encoding="utf-8"?>
<!--
This is the background of the search edit view.
Those colors will mix at runtime with the tin used for the search bar.
See: [BrowserActivity.setSearchBarColors]
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <!--
    Background while not focused: transparent fill with a subtle pill outline so the field
    is still visible even though the focus pill is only shown while focused.
    The stroke is white on purpose: it is tinted at runtime in [BrowserActivity.setSearchBarColors].
    -->
    <item android:state_focused="false" >
        <shape>
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/white"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <!--
    Background while focused: the pill, tinted at runtime. See [BrowserActivity.setSearchBarColors]
    -->
    <item android:state_focused="true" >
        <shape>
            <solid android:color="@color/white"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</selector>