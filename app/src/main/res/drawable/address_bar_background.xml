<?xml version="1.0" encoding="utf-8"?>
<!--
This is the background of the search edit view.
Those colors will mix at runtime with the tin used for the search bar.
See: [BrowserActivity.setSearchBarColors]
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <!--
    Background while not focused: fully transparent so the address bar blends into the toolbar.
    No pill and, together with the container elevation being dropped to zero, no shadow.
    -->
    <item android:state_focused="false" >
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <!--
    Background while focused: the pill, tinted at runtime. See [BrowserActivity.setSearchBarColors]
    -->
    <item android:state_focused="true" >
        <shape>
            <solid android:color="@color/white"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</selector>